<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GraphQLite.Cypher</RootNamespace>
    <AssemblyName>GraphQLite.Cypher</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Description>openCypher parser: query text to syntax tree, with no dependency on the database engine (only on the value model of GraphQLite.Core).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraphQLite.Core\GraphQLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphQLite.Tests" />
  </ItemGroup>

</Project>
