<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GraphDb</RootNamespace>
    <AssemblyName>GraphDb</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Description>Embedded, in-process graph database with openCypher support.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphDb.Tests" />
    <InternalsVisibleTo Include="GraphDb.Server" />
  </ItemGroup>

</Project>
